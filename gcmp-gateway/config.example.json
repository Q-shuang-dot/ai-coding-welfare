      "apiKey": "sk-REPLACE_ME",
      "pricing": {
        "type": "per_call",
        "price": 0.3
      },
      "headers": {
        "User-Agent": "claude-cli/1.0.60 (external, cli)"
      }
    },
    "agentrouter": {
      "baseUrl": "https://agentrouter.org/v1",
      "apiKey": "sk-REPLACE_ME",
      "pricing": {
        "type": "per_token",
        "in": 2,
        "out": 6,
        "models": {
          "claude-opus-5": {
            "in": 8,
            "out": 40
