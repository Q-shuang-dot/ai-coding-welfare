          "gpt-5.6-sol": {
            "in": 3,
            "out": 15
          }
        }
      },
      "headers": {
        "User-Agent": "claude-cli/1.0.60 (external, cli)"
      }
    },
    "zhipu": {
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKey": "sk-REPLACE_ME",
      "noProxy": true
    },
    "matrix": {
      "baseUrl": "https://mzsjai.com/v1",
      "apiKey": "sk-REPLACE_ME"
    },
