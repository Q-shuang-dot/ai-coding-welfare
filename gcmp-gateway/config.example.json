{
  "listen": {
    "host": "127.0.0.1",
    "port": 15800
  },
  "access": {
    "enabled": true,
    "apiKey": "gcmp-local-REPLACE_ME"
  },
  "alias": {
    "claude-sonnet-4-5": "sonnet-5"
  },
  "proxy": "http://127.0.0.1:7897",
  "timeouts": {
    "connect": 25,
    "open": 90,
    "read": 300
  },
  "health": {
    "interval": 30
  },
  "breaker": {
    "enabled": true,
    "threshold": 3,
    "cooldown": 300
  },
  "upstreams": {
    "agentrouter": {
      "baseUrl": "https://agentrouter.org/v1",
      "apiKey": "sk-REPLACE_ME",
      "headers": {
        "User-Agent": "claude-cli/1.0.60 (external, cli)"
      },
      "pricing": {
        "type": "per_token",
        "in": 2,
        "out": 6
      }
    }
  },
  "models": [
    {
      "id": "deepseek",
      "name": "DeepSeek-V4",
      "maxInputTokens": 128000,
      "maxOutputTokens": 8192,
      "route": [
        {
          "upstream": "agentrouter",
          "model": "deepseek-v4-flash",
          "vision": false
        }
      ]
    }
  ],
  "bridge": {
    "enabled": false,
    "script": "codex-bridge\\bridge.py",
    "port": 15731
  },
  "examples": {
    "add_upstream": "{\n  \"my-upstream\": {\n    \"baseUrl\": \"https://api.example.com/v1\",\n    \"apiKey\": \"sk-YOUR_KEY\"\n  }\n}",
    "add_model": "{\n  \"id\": \"my-model\",\n  \"name\": \"My Model\",\n  \"maxInputTokens\": 128000,\n  \"maxOutputTokens\": 8192,\n  \"route\": [\n    {\n      \"upstream\": \"my-upstream\",\n      \"model\": \"actual-model-name\"\n    }\n  ]\n}"
  }
}