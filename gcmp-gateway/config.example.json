        {
          "upstream": "justwoker",
          "model": "claude-opus-5"
        },
        {
          "upstream": "gorouter",
          "model": "claude-opus-5"
        },
        {
          "upstream": "kktoken",
          "model": "claude-opus-5"
        },
        {
          "upstream": "tokenbom",
          "model": "claude-opus-5"
