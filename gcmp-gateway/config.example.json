    },
    "tabitoken": {
      "baseUrl": "https://tabitoken.com/v1",
      "apiKey": "sk-REPLACE_ME",
      "pricing": {
        "type": "per_call",
        "price": 0.8
      }
    },
    "gorouter": {
      "baseUrl": "https://gorouter.app/v1",
      "apiKey": "sk-REPLACE_ME",
      "pricing": {
        "type": "per_call",
        "price": 0.3
      }
    },
    "seekai": {
      "baseUrl": "https://seekai.cc/v1",
      "apiKey": "sk-REPLACE_ME",
      "headers": {
